# Copy to .env (in this same cmd/server directory) and fill in your values.
# The server loads .env automatically — it looks next to the config file
# first, then in the working directory.
# (variables already set in the shell take precedence).
#   cp cmd/server/.env.example cmd/server/.env

# OpenAI-compatible API base URL. Leave as the official endpoint unless you
# use a compatible provider (e.g. https://llm.example.com/v1).
OPENAI_ENDPOINT=https://api.openai.com/v1

# OpenAI API key (required).
OPENAI_APIKEY=sk-...

# Chat model used to clean up poems and build the reading script.
OPENAI_MODEL=gpt-4o-mini

# Text-to-speech model used by the OpenAI TTS engine.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
